+/* How often the autoscroll time-to-end in the label is refreshed */
+#define TIME_LEFT_REFRESH_MS 250
+
 static guint widget_signals[WIDGET_N_SIGNALS] = {0, };
 
 G_DEFINE_TYPE (EvPageActionWidget, ev_page_action_widget, GTK_TYPE_TOOL_ITEM)
@@ -58,10 +64,27 @@ update_pages_label (EvPageActionWidget *action_widget,
 {
 	char *label_text;
 	gint n_pages;
+	gint secs_left = 0;
+
+	if (action_widget->doc_model)
+		secs_left = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (action_widget->doc_model),
+								EV_VIEW_AUTOSCROLL_SECS_LEFT_KEY));
+	action_widget->showing_time_left = FALSE;
 
 	n_pages = ev_document_get_n_pages (action_widget->document);
 	if (ev_document_has_text_page_labels (action_widget->document)) {
-		label_text = g_strdup_printf (_("(%d of %d)"), page + 1, n_pages);
+		if (secs_left > 0) {
+			gboolean hours = (secs_left / 60) / 60 > 1;
+			gint big_left = hours ? (secs_left / 60) / 60 : secs_left / 60;
+			gint small_left = hours ? (secs_left / 60) % 60 : secs_left % 60;
+
+			label_text = g_strdup_printf (_("(%d of %d) %d%s %d%s"), page + 1, n_pages,
+						      big_left, hours ? "h" : "m",
+						      small_left, hours ? "m" : "s");
+			action_widget->showing_time_left = TRUE;
+		} else {
+			label_text = g_strdup_printf (_("(%d of %d)"), page + 1, n_pages);
+		}
 	} else {
 		label_text = g_strdup_printf (_("of %d"), n_pages);
 	}
@@ -101,6 +124,24 @@ page_changed_cb (EvDocumentModel    *model,
 	ev_page_action_widget_set_current_page (action_widget, new_page);
 }
 
+static gboolean
+time_left_refresh_cb (EvPageActionWidget *action_widget)
+{
+	gpointer secs_left;
+
+	if (!action_widget->document || !action_widget->doc_model)
+		return G_SOURCE_CONTINUE;
+
+	secs_left = g_object_get_data (G_OBJECT (action_widget->doc_model),
+				       EV_VIEW_AUTOSCROLL_SECS_LEFT_KEY);
+	/* Also refresh once after autoscroll stops, to clear the time */
+	if (secs_left || action_widget->showing_time_left)
+		update_pages_label (action_widget,
+				    ev_document_model_get_page (action_widget->doc_model));
+
+	return G_SOURCE_CONTINUE;
+}
+
 static gboolean
 page_scroll_cb (EvPageActionWidget *action_widget, GdkEventScroll *event)
 {
@@ -188,6 +229,10 @@ ev_page_action_widget_init (EvPageActionWidget *action_widget)
 	gtk_widget_show (hbox);
 
 	gtk_widget_show (GTK_WIDGET (action_widget));
+
+	action_widget->time_left_refresh_id =
+		g_timeout_add (TIME_LEFT_REFRESH_MS, (GSourceFunc)time_left_refresh_cb,
+			       action_widget);
 }
 
 static void
@@ -239,6 +284,19 @@ ev_page_action_widget_set_model (EvPageActionWidget *action_widget,
 			  action_widget);
 }
 
+static void
+ev_page_action_widget_dispose (GObject *object)
+{
+	EvPageActionWidget *action_widget = EV_PAGE_ACTION_WIDGET (object);
+
+	if (action_widget->time_left_refresh_id > 0) {
+		g_source_remove (action_widget->time_left_refresh_id);
+		action_widget->time_left_refresh_id = 0;
+	}
+
+	G_OBJECT_CLASS (ev_page_action_widget_parent_class)->dispose (object);
+}
+
 static void
