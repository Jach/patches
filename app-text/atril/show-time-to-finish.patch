 {
@@ -278,6 +336,7 @@ ev_page_action_widget_class_init (EvPageActionWidgetClass *class)
 {
 	GObjectClass *object_class = G_OBJECT_CLASS (class);
 
+	object_class->dispose = ev_page_action_widget_dispose;
 	object_class->finalize = ev_page_action_widget_finalize;
 
 	widget_signals[WIDGET_ACTIVATE_LINK] =
diff --git a/libview/ev-view.c b/libview/ev-view.c
index 5301079..5f30008 100644
--- a/libview/ev-view.c
+++ b/libview/ev-view.c
@@ -6765,6 +6765,26 @@ ev_view_autoscroll_cb (EvView *view)
 		       gtk_adjustment_get_page_size (view->vadjustment));
 	gtk_adjustment_set_value (view->vadjustment, value);
 
+	/* Publish the estimated time to reach the end of the document on the
+	 * model, where the page action widget polls it for its label. */
+	if (speed > 0) {
+		gdouble w, h, end_of_doc_vadj, vadj_left, secs_left;
+		gint pages;
+
+		ev_document_get_page_size (view->document, 0, &w, &h);
+		pages = ev_document_get_n_pages (view->document);
+
+		end_of_doc_vadj = h * (pages - 1) * view->scale;
+		vadj_left = end_of_doc_vadj - value;
+		/* speed is vadj per 20 millis (see autoscroll_start's timeout add call) so to get time... */
+		secs_left = ((20.0 / speed) * vadj_left) / 1000.0;
+
+		g_object_set_data (G_OBJECT (view->model), EV_VIEW_AUTOSCROLL_SECS_LEFT_KEY,
+				   GINT_TO_POINTER ((gint) CLAMP (secs_left, 0, G_MAXINT)));
+	} else {
+		g_object_set_data (G_OBJECT (view->model), EV_VIEW_AUTOSCROLL_SECS_LEFT_KEY, NULL);
+	}
+
 	return TRUE;
 
 }
@@ -6795,6 +6815,9 @@ ev_view_autoscroll_stop (EvView *view)
 
 	g_return_if_fail (EV_IS_VIEW (view));
 
+	if (view->model)
+		g_object_set_data (G_OBJECT (view->model), EV_VIEW_AUTOSCROLL_SECS_LEFT_KEY, NULL);
+
 	if (!view->scroll_info.autoscrolling)
 		return;
 
