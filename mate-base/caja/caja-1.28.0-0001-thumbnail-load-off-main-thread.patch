+/* Runs in a worker thread, so decoding a big image doesn't block the UI. */
+static void
+thumbnail_load_thread (GTask *task,
+                       gpointer source_object,
+                       gpointer task_data,
+                       GCancellable *cancellable)
+{
+    ThumbnailLoad *load;
+    GdkPixbuf *pixbuf;
+
+    load = task_data;
+    pixbuf = NULL;
+
+    if (load->original != NULL)
+    {
+        pixbuf = get_pixbuf_for_location (load->original, load->max_size, cancellable);
+    }
+
+    /* Fall back to the thumbnail if the original couldn't be loaded */
+    if (pixbuf == NULL && load->thumbnail != NULL &&
+            !g_cancellable_is_cancelled (cancellable))
+    {
+        pixbuf = get_pixbuf_for_location (load->thumbnail, load->max_size, cancellable);
+    }
+
+    g_task_return_pointer (task, pixbuf, g_object_unref);
+}
